{
  "name": "@qa/backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
